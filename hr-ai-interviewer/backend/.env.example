# Server
PORT=8080
# Public HTTPS URL Plivo can reach (use ngrok in dev; your deployed backend's own URL in prod).
# e.g. https://your-app.onrender.com — no trailing slash.
PUBLIC_BASE_URL=

# Gemini
# Named HR_APP_GEMINI_KEY (not GEMINI_API_KEY) on purpose: some deploy platforms treat the
# exact name GEMINI_API_KEY as a special, auto-managed key tied to your currently logged-in
# account/project, and won't let you paste in a key from a different account. This name is
# just an ordinary secret, so you can set it to any Gemini API key you have.
HR_APP_GEMINI_KEY=
# Live API voice used for phone calls. Options include Aoede, Puck, Charon, Kore, Fenrir, Zephyr —
# see https://ai.google.dev/gemini-api/docs/live-api for the current full list.
GEMINI_VOICE_NAME=Aoede

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo number, with country code, no spaces or dashes. e.g. +91XXXXXXXXXX
PLIVO_FROM_NUMBER=

# Google Sheets logging (via Apps Script — see docs/apps-script/Code.gs)
# 1. Open your sheet -> Extensions -> Apps Script -> paste in docs/apps-script/Code.gs
# 2. Set SECRET in that script to a long random string
# 3. Deploy -> New deployment -> Web app -> Execute as Me -> Who has access: Anyone
# 4. Paste the Web app URL below, and the same SECRET value
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_SECRET=
