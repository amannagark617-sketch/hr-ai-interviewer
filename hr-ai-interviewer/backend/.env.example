# Server
PORT=8080
# Public HTTPS URL Plivo can reach (use ngrok in dev; your deployed backend's own URL in prod).
# e.g. https://your-app.onrender.com — no trailing slash.
PUBLIC_BASE_URL=

# Gemini
GEMINI_API_KEY=
# Text model used to score resumes/transcripts. Google retires model IDs periodically — if
# ranking starts failing with a 404 "model ... is no longer available" error, the error message
# names the current replacement; set it here to swap models without a code change.
# Default: gemini-3.6-flash
GEMINI_TEXT_MODEL=
# Live API voice used for phone calls. Options include Aoede, Puck, Charon, Kore, Fenrir, Zephyr —
# see https://ai.google.dev/gemini-api/docs/live-api for the current full list.
GEMINI_VOICE_NAME=Aoede
# Live API (phone call) model — separate rotation schedule from GEMINI_TEXT_MODEL above. If a
# call's logs show "model not found" on the Gemini Live socket, set the current name here.
# Default: models/gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo number, with country code, no spaces or dashes. e.g. +91XXXXXXXXXX
PLIVO_FROM_NUMBER=

# Google Sheets logging (via Apps Script — see docs/apps-script/Code.gs)
# 1. Open your sheet -> Extensions -> Apps Script -> paste in docs/apps-script/Code.gs
# 2. Set SECRET in that script to a long random string
# 3. Deploy -> New deployment -> Web app -> Execute as Me -> Who has access: Anyone
# 4. Paste the Web app URL below, and the same SECRET value
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_SECRET=

# In-app Dashboard tab — reads the same sheet via its published-CSV URL instead of hitting the
# Apps Script endpoint repeatedly (avoids 403/303 issues from that). In your Sheet:
# File -> Share -> Publish to web -> pick the "Round 1" tab -> format CSV -> Publish. Paste the
# URL it gives you below. Fetched server-side (see routes/dashboard.js) so the browser never has
# to fetch Google directly, which can hit CORS.
SHEET_CSV_URL=
